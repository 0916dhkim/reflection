# EXTRACTION_REASONING_EFFORT=medium
# EXTRACTION_NATIVE_SCHEMA=true
# RESOLUTION_MODEL=openai/gpt-5.6-luna
# RESOLUTION_PROVIDER=azure
# RESOLUTION_REASONING_EFFORT=medium
# RESOLUTION_NATIVE_SCHEMA=true
# EMBEDDING_MODEL=voyage-4-large
