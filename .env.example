POSTGRES_DB=reflection
POSTGRES_USER=reflection
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://reflection:replace-with-url-encoded-password@db:5432/reflection

REFLECTION_API_KEY=replace-with-a-random-api-key
OPENROUTER_API_KEY=replace-with-an-openrouter-key
VOYAGE_API_KEY=replace-with-a-voyage-key

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
