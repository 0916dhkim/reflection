# WORKER_POLL_SECONDS=1
# WORKER_MAX_ATTEMPTS=3
# WORKER_RETRY_BACKOFF_SECONDS=2
# MODEL_CALL_TIMEOUT_SECONDS=180
# LOG_LEVEL=INFO
