{
  "name": "@reflection/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --external:fastify --external:@fastify/swagger --external:@fastify/swagger-ui --external:pg",
    "start": "node dist/main.js",
    "test": "vitest run --exclude test/database.integration.test.ts",
    "test:integration": "node -e \"if (!process.env.REFLECTION_TEST_DATABASE_URL) { console.error('REFLECTION_TEST_DATABASE_URL is required and must identify a disposable database'); process.exit(1); }\" && vitest run test/database.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@reflection/shared": "workspace:*",
    "fastify": "5.12.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
